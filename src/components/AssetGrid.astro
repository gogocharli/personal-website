---
import { ASSET_URL } from '../consts';

interface Asset {
  type: 'image' | 'video';
  url: string;
}

export interface Props {
  assets: Asset[];
  caption?: string;
}

const { assets, caption } = Astro.props;
---

<figure>
  <div class='asset-grid-container'>
    {
      assets.map((asset) =>
        asset.type === 'image' ? (
          <img src={`/${asset.url}`} />
        ) : (
          <video autoplay loop muted playsinline>
            <source src={`${ASSET_URL}/${asset.url}`} type='video/webm' />
          </video>
        ),
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  figcaption {
    font-size: 0.8rem;
    color: var(--color-neutral-400);
    text-align: center;
    margin-top: 1rem;
    text-decoration: underline;
    font-variation-settings:
      'wght' 400,
      'ital' 1;
  }

  .asset-grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .asset-grid-container > * {
    border-radius: 0.25rem;
    transition: transform 0.25s ease-in-out;
  }

  .asset-grid-container > *:hover {
    transform: scale(1.01);
    filter: brightness(1.1);
  }
</style>
