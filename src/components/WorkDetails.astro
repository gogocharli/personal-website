---
import AssetGrid from './AssetGrid.astro';

interface Asset {
  type: 'image' | 'video';
  url: string;
}

interface Project {
  title: string;
  url?: string;
  description?: string;
  assets?: Asset[];
  caption?: string;
}

export interface Props {
  companyName: string;
  timeline: {
    // date format: MM-DD-YYYY
    from: string;
    to?: string;
  };
  role: string | string[];
  description: string;
  projects?: Project[];
}

const { companyName, timeline, role, description, projects } = Astro.props;

const visibleDateFormat = new Intl.DateTimeFormat('en-us', {
  year: '2-digit',
  month: 'numeric',
});
const datetimeFormat = new Intl.DateTimeFormat('en-us', {
  year: 'numeric',
  month: 'numeric',
});

const dateFrom = visibleDateFormat.format(new Date(timeline.from));
const datetimeFrom = datetimeFormat.format(new Date(timeline.from));

const dateTo = timeline.to
  ? visibleDateFormat.format(new Date(timeline.to))
  : 'current';

const datetimeTo = timeline.to
  ? datetimeFormat.format(new Date(timeline.to))
  : datetimeFormat.format(new Date());
---

<details name={companyName} open>
  <summary role='heading'
    ><h3>
      {companyName}
      <span class='timeline'
        ><time datetime={datetimeFrom}>{dateFrom}</time>&#8211;<time
          datetime={datetimeTo}>{dateTo}</time
        ></span
      >
    </h3></summary
  >
  <div class='details__content'>
    {
      Array.isArray(role) ? (
        <p>
          {role[0]}{' '}
          <span class='sprite'>
            <img class='mario-sprite' src='/mario-sprite.png' alt='' />
          </span>
          <span class='promotion'>{role[1]}</span>
        </p>
      ) : (
        <p>{role}</p>
      )
    }
    <p>
      {description}
    </p>

    {
      projects ? (
        <section>
          <h4>Projects</h4>
          <ul class='project-list'>
            {projects.map((project) => (
              <li class='project-item'>
                <div>
                  <h5 class='project-title'>
                    {project.url ? (
                      <a target='_blank' rel='noopener' href={project.url}>
                        {project.title}
                      </a>
                    ) : (
                      <span>{project.title}</span>
                    )}
                  </h5>
                  {project.description && (
                    <p class='project-description'>{project.description}</p>
                  )}
                  {project.assets && (
                    <AssetGrid
                      assets={project.assets}
                      caption={project.caption}
                    />
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
  </div>
</details>

<style>
  details {
    font-feature-settings: 'calt';
  }

  summary h3 {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .timeline {
    font-variation-settings:
      'wght' 400,
      'ital' 1;
    border: 1px solid currentColor;
    padding: 0.25em 0.5em;
    border-radius: 1em;
    font-size: 0.75em;
  }

  h3 time {
    font-feature-settings: 'ss04';
  }

  h4 {
    text-transform: uppercase;
    font-variation-settings:
      'wght' 200,
      'ital' 0;
    text-decoration: none;
    text-align: center;
    margin-block: 1rem;
  }

  .promotion {
    font-variation-settings:
      'wght' 600,
      'ital' 0;
  }

  .mario-sprite {
    display: inline-block;
    transform: translateY(-4px);
    height: 1em;
  }

  .details__content {
    margin-bottom: 1.5rem;
  }

  a[target='_blank']::after {
    content: '\2197';
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
