---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION, ASSET_URL } from '../consts';
---

<!doctype html>
<html lang='en'>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <h1>Charles <span class='ital'>de Mount</span> Yahouédéou</h1>
      <p>
        Hey there! I am an award-winning designer and software developer with <span
          class='circled'>5</span
        > years of experience building on my own, with agencies, and fast-paced startup
        environments.
      </p>
      <section class='work-details'>
        <h2>I've worked at</h2>
        <details name='work' data-title='SuperHi'>
          <summary role='heading'
            ><h3>
              SuperHi
              <span class='timeline'
                ><time datetime='2022-05'>05/22</time>&#8211;<time
                  datetime='2024-12'>12/24</time
                ></span
              >
            </h3></summary
          >
          <div class='details__content'>
            <p>
              Frontend Engineer <span class='sprite'
                ><img
                  class='mario-sprite'
                  src='/mario-sprite.png'
                  alt=''
                /></span
              >
              <span class='promotion'>Senior Software Engineer</span>
            </p>
            <p>
              I spent a great couple of years (May 2022 - Dec 2024) at SuperHi,
              a high-growth startup, climbing from Front-End to Senior Software
              Developer. I got to build and document a flexible design system
              that helped keep things consistent across tons of sites. A big
              focus was also making our own engineering team faster. I helped
              improve workflows with better testing, logging, and documentation,
              which even sped up how quickly we could launch new courses (from
              months to just 2 weeks!). On the Senior side, I played a key role
              in projects that really moved the needle, boosting revenue by 22%
              with new sites and improving user retention by 10% by tackling UI
              issues. Plus, I optimized performance, cutting load times by 40%,
              and even prototyped fun stuff like AI-powered learning tools.
            </p>

            <section>
              <h4>Projects</h4>
              <ul class='project-list'>
                <li class='project-item'>
                  <div>
                    <h5 class='project-title'>
                      <a
                        target='_blank'
                        rel='noopener'
                        href='https://dribbble.com/shots/25309216-SuperHi-Platform-and-Marketing-Site-Redesign'
                        >SuperHi Platform Redesign</a
                      >
                    </h5>
                    <p class='project-description'>
                      Spearheaded a platform redesign at SuperHi that drove a
                      22% increase in conversion and a 209% customer growth for
                      over 50,000 users. I led the technical execution, which
                      involved a full-stack migration to Next.js 14,
                      implementing a new, award-winning front-end, and
                      redesigning core content, the dashboard, and the video
                      player experience.
                    </p>
                    <div class='asset-grid'>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-home-hero-load.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-homepage-about-hero.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-homepage-testimonial.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/videos/sh-homepage-footer.mp4`}
                          type='video/mp4'
                        />
                      </video>
                    </div>
                  </div>
                </li>
                <li class='project-item'>
                  <div>
                    <h5 class='project-title'>
                      <a
                        target='_blank'
                        rel='noopener'
                        href='https://dribbble.com/shots/25309292-SuperHi-Plus'
                        >SuperHi Plus</a
                      >
                    </h5>
                    <p class='project-description'>
                      SuperHi Plus is a program by SuperHi, making it easier to
                      recruit promising creatives from around the world and
                      mentor them to become educators. I drove a 47% increase in
                      traffic to SuperHi's main site through the successful
                      launch of the SuperHi Plus sub-brand. As a Frontend
                      Engineer, I developed the program's engaging and
                      interactive website, focusing on motion and performance to
                      create an immersive user experience. The launch exceeded
                      all targets, attracting over 14,000 visitors and doubling
                      the expected number of applicants.
                    </p>
                    <div class='asset-grid'>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-plus.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-plus-courses.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-plus-explore-section.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/sh-plus-quote-section.mp4`}
                          type='video/mp4'
                        />
                      </video>
                    </div>
                  </div>
                </li>
                <li class='project-item'>
                  <div>
                    <h5 class='project-title'>
                      <a target='_blank' rel='noopener' href='bounties.sh'
                        >Bounties</a
                      >
                    </h5>
                    <p>
                      Bounties was a SuperHi platform designed to make it easier
                      for freelancers to find creative projects and get paid
                      transparently. Based on Ethereum smart contracts, clients
                      would put their project funds in escrow which would then
                      be used to pay creators after their work was completed.
                    </p>
                    <div class='asset-grid'>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/bounties-homepage-1.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/bounties-homepage-2.mp4`}
                          type='video/mp4'
                        />
                      </video>
                      <video autoplay loop muted>
                        <source
                          src={`${ASSET_URL}/bounties-homepage-3.mp4`}
                          type='video/mp4'
                        />
                      </video>
                    </div>
                  </div>
                </li>
                <li class='project-item'>And more…</li>
              </ul>
            </section>
          </div>
        </details>
        <details name='work'>
          <summary role='heading'
            ><h3>
              Vercel <span class='timeline'
                ><time datetime='2021-09'>09/21</time>&#8211;<time
                  datetime='2022-05'>05/22</time
                ></span
              >
            </h3></summary
          >
        </details>
        <details name='work'>
          <summary role='heading'
            ><h3>
              Lyncxs <span class='timeline'
                ><time datetime='2020-04'>04/20</time>&#8211;<time
                  datetime='2021-03'>03/21</time
                ></span
              >
            </h3>
          </summary>
        </details>
        <details name='work'>
          <summary role='heading'
            ><h3>Freelance Creative Technologist</h3>
          </summary>
        </details>
      </section>
      <section>
        <h2>I've built</h2>
        <ul>
          <li><h3>Raynab: An AI powered extension for YNAB</h3></li>
          <li>
            <h3>
              Enigma: A recreation of the Enigma Machine using React hooks
            </h3>
          </li>
        </ul>
      </section>
      <section>
        <h2>I love</h2>
        <ul>
          <li>CityPop</li>
          <li>Bass riffs</li>
          <li>Rap bars</li>
          <li>Ok, music in general</li>
          <li>Serifs</li>
          <li>Computers</li>
          <li>Cycling</li>
          <li>Cooking</li>
          <li>Fashion</li>
          <li>Chrono Trigger</li>
          <li>Axelle</li>
        </ul>
      </section>

      <section class='recommendations'>
        <blockquote
          cite='https://www.linkedin.com/in/charles-yahouedeou/details/recommendations/'
        >
          <p>
            I would highly recommend Charles to any team looking for a software
            engineer who goes beyond writing code — someone who truly
            understands how technology can create delightful, accessible and
            memorable experiences(<a
              href='https://www.linkedin.com/in/charles-yahouedeou/details/recommendations/'
              >&hellip;</a
            >)
          </p>
          <cite>&#8212;Panna Nyeste</cite>, <cite
            >Head of Design at SuperHi</cite
          >
        </blockquote>
      </section>
    </main>

    <canvas id='shader'></canvas>
    <style>
      .ital {
        font-style: italic;
      }

      .circled {
        font-feature-settings: 'ss03';
        font-size: 1.6rem;
        color: var(--color-amethyst-400);
        line-height: 1;
      }

      h2 {
        /* font-size: 1.25rem; */
        font-variation-settings:
          'wght' 400,
          'ital' 1;
        text-decoration: underline;
      }

      h3 {
        font-variation-settings:
          'wght' 600,
          'ital' 0;
      }

      details {
        font-feature-settings: 'calt';
      }

      summary h3 {
        display: inline-flex;
        gap: 0.5rem;
        align-items: center;
      }

      .timeline {
        font-variation-settings:
          'wght' 400,
          'ital' 1;
        border: 1px solid currentColor;
        padding: 0.25em 0.5em;
        border-radius: 1em;
        font-size: 0.75em;
      }

      h3 time {
        font-feature-settings: 'ss04';
      }

      h4 {
        text-transform: uppercase;
        font-variation-settings:
          'wght' 200,
          'ital' 0;
        text-decoration: none;
        text-align: center;
        margin-block: 1rem;
      }

      .promotion {
        font-variation-settings:
          'wght' 600,
          'ital' 0;
      }

      .mario-sprite {
        display: inline-block;
        transform: translateY(-4px);
        height: 1em;
      }

      .details__content {
        margin-bottom: 1.5rem;
      }

      a[target='_blank']::after {
        content: '\2197';
      }

      blockquote {
        margin: 1rem 2rem;
        padding: 1em 2em;
        border: 2px dashed var(--color-neutral-400);
      }

      .asset-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .asset-grid video,
      .asset-grid img {
        border-radius: 0.25rem;
        transition: transform 0.25s ease-in-out;
      }

      .asset-grid video:hover,
      .asset-grid img:hover {
        transform: scale(1.01);
        cursor: zoom-in;
      }

      .project-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
    </style>
  </body>
</html>
